# Dominio de tu tienda (el .myshopify.com, no el dominio personalizado)
VITE_SHOPIFY_STORE_DOMAIN=f1luxuryedtionn.myshopify.com

# Token de la Storefront API (el "público" de la app Headless).
# Es seguro exponerlo en el navegador: solo permite leer catálogo y crear carritos.
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Versión de la Storefront API
VITE_SHOPIFY_API_VERSION=2026-07

# NUNCA pongas aquí el token privado ni un token shpat_ (Admin API).
# Todo lo que empieza por VITE_ termina dentro del JavaScript público.
